{
    "mutsumi.customProviders": {
        "ZenMux": {
            "displayName": "ZenMux",
            "baseUrl": "https://zenmux.ai/api/v1",
            "api": "openai-completions",
            "auth": "apiKey",
            "models": [
                "z-ai/glm-5.2"
            ]
        }
    },
    "mutsumi.defaultModel": {
        "provider": "kimi-coding",
        "model": "kimi-for-coding"
    },
    "mutsumi.titleGeneratorModel": {
        "provider": "kimi-coding",
        "model": "kimi-for-coding"
    },
    "mutsumi.compressModel": {
        "provider": "ZenMux",
        "model": "z-ai/glm-5.2"
    },
    "_comment": "Configure LLM API keys with Mutsumi: Manage Model Providers. Keys are stored in VS Code SecretStorage and never belong in this JSON.",
    "mutsumi.httpServer.password": "XXX",
    "mutsumi.mcpServers": {
        "exa": {
            "type": "http",
            "url": "https://mcp.exa.ai/mcp",
            "headers": {
                "x-api-key": "XXX"
            }
        }
    }
}
